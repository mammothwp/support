{
    "name": "mammothwp/support",
    "description": "One shared Support screen for every plugin that bundles it: the customer fills a form, the site sends one email with an optional, previewable site report.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "homepage": "https://mammothwp.com",
    "keywords": [
        "wp",
        "support",
        "plugin",
        "site-report"
    ],
    "authors": [
        {
            "name": "Mammoth WP",
            "email": "info@mammothwp.com",
            "homepage": "https://mammothwp.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "mammothwp/wp-kit": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.0",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.10",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "php-stubs/wp-cli-stubs": "^2.11",
        "brain/monkey": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "MammothWP\\Support\\": "src/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MammothWP\\Support\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "git ls-files -z --cached --others --exclude-standard -- '*.php' | xargs -0 -n1 php -l",
        "test": "phpunit",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyse --memory-limit=1G"
    }
}
